## Color coding:
#########################
##  Main FRR: #f08080  red
##  Switches: #d0e0d0  gray
##  RIP:      #19e3d9  Cyan
##  RIPng:    #fcb314  dark yellow
##  OSPFv2:   #32b835  Green
##  OSPFv3:   #19e3d9  Cyan
##  ISIS IPv4 #fcb314  dark yellow
##  ISIS IPv6 #9a81ec  purple
##  BGP IPv4  #eee3d3  beige
##  BGP IPv6  #fdff00  yellow
##  host:     #4f4f4f  gray31
##### Colors (see http://www.color-hex.com/)

graph test_evpn_anycast_macvlan {
  label="test-evpn-anycast-macvlan";

  # Routers
  r1 [
    shape=doubleoctagon,
    label="r1",
    fillcolor="#f08080",
    style=filled,
  ];
  r2 [
    shape=doubleoctagon,
    label="r2",
    fillcolor="#f08080",
    style=filled,
  ];

  host1 [
    shape=rectangle,
    label="host1\n192.168.10.10/24",
    fillcolor="#4f4f4f",
    style=filled,
  ];
  host2 [
    shape=rectangle,
    label="host2\n192.168.20.10/24",
    fillcolor="#4f4f4f",
    style=filled,
  ];
  host3 [
    shape=rectangle,
    label="host3\n192.168.10.20/24",
    fillcolor="#4f4f4f",
    style=filled,
  ];
  host4 [
    shape=rectangle,
    label="host4\n192.168.20.20/24",
    fillcolor="#4f4f4f",
    style=filled,
  ];

  # Switches
  s1 [
    shape=oval,
    label="s1",
    fillcolor="#d0e0d0",
    style=filled,
  ];
  s2 [
    shape=oval,
    label="s2",
    fillcolor="#d0e0d0",
    style=filled,
  ];
  s3 [
    shape=oval,
    label="s3",
    fillcolor="#d0e0d0",
    style=filled,
  ];
  s4 [
    shape=oval,
    label="s4",
    fillcolor="#d0e0d0",
    style=filled,
  ];

  # Connections
  r1 -- s1
  r1 -- s2
  r2 -- s3
  r2 -- s4
  s1 -- host1
  s2 -- host2
  s3 -- host3
  s4 -- host4
}
